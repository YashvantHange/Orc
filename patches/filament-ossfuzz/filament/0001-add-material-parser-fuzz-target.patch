+ * limitations under the License.
+ */
+
+/*
+ * A main() that runs a fuzz target over files named on the command line, without linking
+ * libFuzzer. It exists so a crashing testcase can be replayed -- in a debugger, in CI, or on a
+ * machine whose toolchain has no libFuzzer runtime -- using the same entry point the fuzzer
+ * drives. It does not mutate anything and finds nothing on its own.
+ *
+ *   material_parser_fuzzer_standalone crash-abc123.filamat
+ */
+
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+#include <stddef.h>
+#include <stdint.h>
+
+extern "C" int LLVMFuzzerTestOneInput(uint8_t const* data, size_t size);
+
+int main(int argc, char** argv) {
+    if (argc < 2) {
+        std::fprintf(stderr, "usage: %s <testcase> [testcase...]\n", argv[0]);
+        return 2;
+    }
+
+    for (int i = 1; i < argc; i++) {
+        std::FILE* file = std::fopen(argv[i], "rb");
+        if (!file) {
+            std::fprintf(stderr, "cannot open %s\n", argv[i]);
+            return 2;
+        }
+
+        std::fseek(file, 0, SEEK_END);
+        long const length = std::ftell(file);
+        std::fseek(file, 0, SEEK_SET);
+
+        if (length < 0) {
+            std::fclose(file);
+            std::fprintf(stderr, "cannot size %s\n", argv[i]);
+            return 2;
+        }
+
+        std::vector<uint8_t> buffer(static_cast<size_t>(length), uint8_t(0));
+        if (length > 0 && std::fread(buffer.data(), 1, size_t(length), file) != size_t(length)) {
+            std::fclose(file);
+            std::fprintf(stderr, "cannot read %s\n", argv[i]);
+            return 2;
+        }
+        std::fclose(file);
+
+        std::printf("running %s (%ld bytes)\n", argv[i], length);
+        std::fflush(stdout);
+
+        LLVMFuzzerTestOneInput(buffer.data(), buffer.size());
+    }
+
+    std::printf("all %d testcase(s) returned normally\n", argc - 1);
+    return 0;
+}
