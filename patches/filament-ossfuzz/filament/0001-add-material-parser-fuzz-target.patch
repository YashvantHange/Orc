+cmake_minimum_required(VERSION 3.19)
+project(filament-fuzzers)
+
+# Fuzz targets are opt-in: -DFILAMENT_ENABLE_FUZZERS=ON. They are built by OSS-Fuzz and can be
+# built locally with clang for reproducing a testcase.
+if (NOT FILAMENT_ENABLE_FUZZERS)
+    return()
+endif()
+
+if (IOS OR WASM OR ANDROID)
+    return()
+endif()
+
+if (NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang")
+    message(FATAL_ERROR "FILAMENT_ENABLE_FUZZERS requires clang (libFuzzer is a clang feature).")
+endif()
+
+# OSS-Fuzz passes the engine to link against in LIB_FUZZING_ENGINE, and instruments the rest of
+# the build through CFLAGS/CXXFLAGS. Outside OSS-Fuzz, fall back to plain libFuzzer, which has to
+# be applied at compile time as well so the target itself gets coverage instrumentation.
+if (DEFINED ENV{LIB_FUZZING_ENGINE})
+    set(FILAMENT_FUZZING_ENGINE "$ENV{LIB_FUZZING_ENGINE}")
+    set(FILAMENT_FUZZING_COMPILE_OPTIONS "")
+else()
+    set(FILAMENT_FUZZING_ENGINE "-fsanitize=fuzzer")
+    set(FILAMENT_FUZZING_COMPILE_OPTIONS "-fsanitize=fuzzer-no-link")
+endif()
+
+function(add_filament_fuzzer NAME)
+    add_executable(${NAME} ${NAME}.cpp)
+
+    # MaterialParser.h is private to the filament library.
+    target_include_directories(${NAME} PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/../src)
+
+    target_link_libraries(${NAME} PRIVATE filament filaflat filabridge utils)
+    target_link_libraries(${NAME} PRIVATE ${FILAMENT_FUZZING_ENGINE})
+
+    if (FILAMENT_FUZZING_COMPILE_OPTIONS)
+        target_compile_options(${NAME} PRIVATE ${FILAMENT_FUZZING_COMPILE_OPTIONS})
+    endif()
+
+    set_target_properties(${NAME} PROPERTIES FOLDER Fuzzers)
+
+    # A replay binary for the same entry point, with no fuzzing engine linked in. Used to
+    # reproduce a crashing testcase, including on toolchains that ship no libFuzzer runtime.
+    add_executable(${NAME}_standalone ${NAME}.cpp standalone_main.cpp)
+    target_include_directories(${NAME}_standalone PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/../src)
+    target_link_libraries(${NAME}_standalone PRIVATE filament filaflat filabridge utils)
+    set_target_properties(${NAME}_standalone PROPERTIES FOLDER Fuzzers)
+endfunction()
+
+add_filament_fuzzer(material_parser_fuzzer)
